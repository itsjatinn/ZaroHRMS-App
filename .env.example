# Copy to .env (or .env.local) and adjust.

# Base URL of the Zaro HRMS backend, WITHOUT the /api prefix.
# Leave it unset in local development: the app then talks to the machine
# running the Expo dev server on port 4000, which is what `nest start:dev`
# binds to, so a phone on the same Wi-Fi reaches your laptop automatically.
# EXPO_PUBLIC_API_BASE_URL=https://api.zarohr.com

# Sentry DSN (optional).
# EXPO_PUBLIC_SENTRY_DSN=
