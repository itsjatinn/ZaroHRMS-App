{
  "expo": {
    "name": "ZaroHR",
    "slug": "zarohr",
    "version": "1.0.1",
    "scheme": "zarohrm",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.zarohr.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.zarohr.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14323F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "ZaroHR",
      "shortName": "ZaroHR",
      "themeColor": "#14323F",
      "backgroundColor": "#14323F",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#14323F"
      }
    },
    "plugins": [
      "./plugins/withSplashIconBackground",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#14323F",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#14323F"
          },
          "android": {
            "image": "./assets/splash-icon-android.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "backgroundColor": "#14323F",
            "dark": {
              "image": "./assets/splash-icon-android.png",
              "backgroundColor": "#14323F"
            }
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "ZaroHR needs access to your photos to update your profile picture.",
          "cameraPermission": "ZaroHR needs access to your camera to take a new profile picture."
        }
      ],
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-build-properties",
      "./plugins/withDatePickerColor",
      "expo-web-browser"
    ]
  }
}
